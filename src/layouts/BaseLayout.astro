---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Rathajatra - Visatos Viešpaties vežimų šventė Vilniuje. Vilniuje, 2026 m. birželio 21 d." } = Astro.props;
---

<!DOCTYPE html>
<html lang="lt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- SEO & Open Graph Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rathajatra Vilnius" />
    
    <ClientRouter />
  </head>
  <body>
    <!-- Premium background glowing aura decoration -->
    <div class="aura-bg" aria-hidden="true" transition:persist="aura-background"></div>
    
    <slot />
  </body>
</html>
