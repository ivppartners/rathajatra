---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Rathajatra - Visatos Viešpaties vežimų šventė Vilniuje. Vilniuje, 2026 m. birželio 21 d." } = Astro.props;

const currentLang = Astro.url.pathname.startsWith('/en') ? 'en' : 'lt';
const pathname = Astro.url.pathname;

let switchUrl = '';
if (currentLang === 'en') {
  if (pathname === '/en' || pathname === '/en/') {
    switchUrl = '/';
  } else if (pathname.startsWith('/en/stories')) {
    switchUrl = pathname.replace('/en/stories', '/istorijos');
  } else {
    switchUrl = pathname.replace(/^\/en/, '') || '/';
  }
} else {
  if (pathname === '/' || pathname === '') {
    switchUrl = '/en/';
  } else if (pathname.startsWith('/istorijos')) {
    switchUrl = pathname.replace('/istorijos', '/en/stories');
  } else {
    const cleanPath = pathname.startsWith('/') ? pathname : `/${pathname}`;
    switchUrl = `/en${cleanPath}`;
  }
}
---

<!DOCTYPE html>
<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- SEO & Open Graph Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rathajatra Vilnius" />
    
    <ClientRouter />
  </head>
  <body>
    <!-- Premium background glowing aura decoration -->
    <div class="aura-bg" aria-hidden="true" transition:persist="aura-background"></div>
    
    <!-- Premium Glassmorphic Language Switcher -->
    <div class="lang-switcher" transition:persist="lang-switcher">
      <a href={switchUrl} class="lang-btn" aria-label={currentLang === 'lt' ? 'Switch to English' : 'Perjungti į lietuvių kalbą'}>
        <span class="lang-icon">🌐</span>
        <span class="lang-text">{currentLang === 'lt' ? 'English' : 'Lietuvių'}</span>
      </a>
    </div>

    <slot />
  </body>
</html>

<style>
  .lang-switcher {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 1000;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.2rem;
    background: rgba(18, 22, 28, 0.6);
    border: 1px solid rgba(255, 106, 0, 0.25);
    border-radius: 50px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-premium);
    color: var(--text-primary);
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: transform var(--transition-bounce), border-color var(--transition-smooth), box-shadow var(--transition-smooth);
    text-shadow: none;
    text-decoration: none;
  }

  .lang-btn:hover {
    color: var(--color-gold) !important;
    border-color: var(--color-saffron);
    box-shadow: var(--shadow-premium), var(--shadow-glow);
    transform: translateY(-2px) scale(1.05);
  }

  .lang-btn:active {
    transform: translateY(1px);
  }

  .lang-icon {
    font-size: 1rem;
    filter: drop-shadow(0 0 4px rgba(255, 106, 0, 0.4));
  }

  /* Responsive styling */
  @media (max-width: 640px) {
    .lang-switcher {
      top: 1rem;
      right: 1rem;
    }
    .lang-btn {
      padding: 0.5rem 1rem;
      font-size: 0.8rem;
    }
  }
</style>

