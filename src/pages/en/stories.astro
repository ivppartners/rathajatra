---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allStories = (await getCollection('stories')).filter(story => story.id.startsWith('en/'));

// Hardcode a mapping for beautiful English descriptions/teasers for each story
const storyTeasers: Record<string, string> = {
  bandhumohanty: "A touching story about the devoted Bandhu Mohanty, for whom Lord Jagannatha Himself secretly brought a golden plate with food.",
  bauri: "The story of pure love of a simple low-caste devotee, Dasia Bauri, when the Lord Himself reached out His hand to accept his offering of a coconut.",
  charchika: "A tale from the Madala Panji chronicles about the powerful goddess Charchika and her spiritual connections with the Puri temple.",
  epidemija: "How Lord Jagannatha helped cure the residents of Puri from a terrible epidemic and granted everyone His protection.",
  ganesa: "A unique tale of how Lord Jagannatha appeared in the form of an elephant (Hati Vesha) to delight a worshiper of Ganesha.",
  gitagovinda: "The masterpiece of the holy poet Jayadeva and his deep mystical connection with the Jagannatha temple, featuring the Lord's own hand finishing his verses.",
  gitapanda: "The wonderful story of Gita Panda, who chanted the Bhagavad-gita, and how Jagannatha miraculously defended him and his purity.",
  hanumanas: "About the faithful eight-armed Hanuman, guarding the gates of the Puri temple from the sound of the ocean waves.",
  isdidusbhaktas: "The story of King Prataparudra, his spiritual humility, and how the Lord shattered his pride and the pride of other devotees.",
  kilme: "A mysterious and grand legend about how King Indradyumna built the temple and how these unique, semi-finished wooden forms originated.",
  musulmonas: "About the Muslim devotee Salabega, whose love was so strong that Jagannatha's chariot stopped and waited for him in the middle of the road.",
  puriolegendos: "A National Geographic documentary about the Puri Ratha-yatra, the secrets of the temple's architecture, and its spiritual significance.",
  vagyste: "An intriguing tale of how the brahmanas tried to secretly transport and hide the deity form of Lord Jagannatha."
};
---

<BaseLayout title="Stories and Legends of Jagannatha - Rathajatra Vilnius">
  <div class="stories-container container">
    <header class="stories-header glass-card">
      <a href="/en" class="btn-back">← Back to main</a>
      <h1>Stories of Jagannatha</h1>
      <p class="subtitle">Discover the thousand-year spiritual legacy and stories of the Jagannatha Puri Temple</p>
    </header>

    <div class="grid-responsive">
      {allStories.map(story => {
        const cleanSlug = story.id.replace('en/', '');
        const teaserKey = cleanSlug.toLowerCase();
        return (
          <a href={`/en/stories/${cleanSlug}`} class="story-card glass-card">
            <div class="card-icon">🪔</div>
            <div class="card-body">
              <h3>{story.data.title}</h3>
              <p>{storyTeasers[teaserKey] || "Read the wonderful legend of the holy land of Lord Jagannatha..."}</p>
              <span class="read-more">Read story →</span>
            </div>
          </a>
        );
      })}
    </div>

    <footer class="stories-footer glass-card">
      <a class="citation-link" href="https://jagannathbaladevsubhadra.blogspot.com/" target="_blank" rel="noopener noreferrer">
        🔗 Cited from: https://jagannathbaladevsubhadra.blogspot.com/
      </a>
      
      <div class="visitor-counter">
        <a target="_blank" rel="noopener noreferrer" href="https://www.hey.lt/details.php?id=rathayatra2023">
          <img width="88" height="31" src="https://www.hey.lt/count.php?id=rathayatra2023" alt="Hey.lt Visitor Counter" />
        </a>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  .stories-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .stories-header {
    padding: 2.5rem;
    text-align: center;
    position: relative;
  }

  .btn-back {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    transition: all var(--transition-smooth);
  }

  .btn-back:hover {
    background: rgba(255, 106, 0, 0.08);
    border-color: var(--color-saffron);
    color: var(--color-gold);
    transform: translateX(-3px);
  }

  .subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }

  /* Story Cards Grid Styling */
  .story-card {
    display: flex;
    gap: 1.25rem;
    padding: 1.75rem;
    text-align: left;
    height: 100%;
  }

  .card-icon {
    font-size: 2rem;
    line-height: 1;
    align-self: flex-start;
    padding: 0.5rem;
    background: rgba(255, 106, 0, 0.06);
    border: 1px solid rgba(255, 106, 0, 0.15);
    border-radius: 12px;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-body h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    transition: color var(--transition-smooth);
  }

  .story-card:hover .card-body h3 {
    color: var(--color-gold);
  }

  .card-body p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more {
    font-family: var(--font-title);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-saffron);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: auto;
  }

  .stories-footer {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .citation-link {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .visitor-counter {
    opacity: 0.6;
    transition: opacity var(--transition-smooth);
  }

  .visitor-counter:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .stories-header {
      padding: 3rem 1.5rem 1.5rem;
    }
    .btn-back {
      top: 1rem;
      left: 50%;
      transform: translateX(-50%);
    }
    .btn-back:hover {
      transform: translateX(-50%) translateY(-2px);
    }
  }
</style>
