---
const currentLang = Astro.url.pathname.startsWith('/en') ? 'en' : 'lt';

const translations = {
  lt: {
    name: 'Vardas',
    namePlaceholder: 'Jūsų vardas...',
    email: 'El. paštas',
    emailPlaceholder: 'el.pastas@pavyzdys.lt',
    message: 'Žinutė',
    messagePlaceholder: 'Jūsų žinutė mums...',
    submit: 'Siųsti žinutę'
  },
  en: {
    name: 'Name',
    namePlaceholder: 'Your name...',
    email: 'Email',
    emailPlaceholder: 'email@example.com',
    message: 'Message',
    messagePlaceholder: 'Your message to us...',
    submit: 'Send message'
  }
};

const t = translations[currentLang];
---
<form id="contact-form" class="contact-form">
  <!-- Honeypot field for spam prevention -->
  <div style="display: none;" aria-hidden="true">
    <label for="website">Website</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field">
    <label for="name">{t.name}</label>
    <input type="text" id="name" name="name" required placeholder={t.namePlaceholder} maxlength="100" />
  </div>
  
  <div class="field">
    <label for="email">{t.email}</label>
    <input type="email" id="email" name="email" required placeholder={t.emailPlaceholder} maxlength="100" />
  </div>
  
  <div class="field">
    <label for="message">{t.message}</label>
    <textarea id="message" name="message" rows="4" required placeholder={t.messagePlaceholder} maxlength="5000"></textarea>
  </div>
  
  <button type="submit" class="btn-premium" style="align-self: flex-start; margin-top: 0.5rem;">{t.submit}</button>
  
  <div id="form-status" class="form-status hidden"></div>
</form>

<script>
  // Add interactive AJAX handler for the contact form
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const statusDiv = document.getElementById('form-status');
    const isEn = window.location.pathname.startsWith('/en');

    const clientT = {
      sending: isEn ? 'Sending...' : 'Siunčiama...',
      success: isEn ? 'Message sent successfully! Thank you.' : 'Žinutė sėkmingai išsiųsta! Ačiū jums.',
      error: isEn ? 'Error sending message. Please try again.' : 'Klaida siunčiant žinutę. Bandykite dar kartą.',
      networkError: isEn ? 'A network error occurred. Please check your internet connection.' : 'Įvyko tinklo klaida. Patikrinkite savo interneto ryšį.'
    };
    
    if (form && statusDiv) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        statusDiv.className = 'form-status info';
        statusDiv.textContent = clientT.sending;
        statusDiv.classList.remove('hidden');
        
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        
        try {
          const response = await fetch('/api/send-email', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
          });
          
          const result = await response.json();
          
          if (response.ok) {
            statusDiv.className = 'form-status success';
            statusDiv.textContent = result.message || clientT.success;
            form.reset();
          } else {
            statusDiv.className = 'form-status error';
            statusDiv.textContent = result.message || clientT.error;
          }
        } catch (error) {
          statusDiv.className = 'form-status error';
          statusDiv.textContent = clientT.networkError;
        }
      });
    }
  });
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    width: 100%;
  }
  
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  label {
    font-family: var(--font-title);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gold);
  }
  
  input, textarea {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.95rem;
    transition: all var(--transition-smooth);
    width: 100%;
  }
  
  input:focus, textarea:focus {
    outline: none;
    border-color: var(--color-saffron);
    box-shadow: 0 0 10px rgba(255, 106, 0, 0.2);
    background: rgba(0, 0, 0, 0.4);
  }
  
  .form-status {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    text-align: center;
    transition: all var(--transition-smooth);
    margin-top: 0.5rem;
  }
  
  .form-status.hidden {
    display: none;
  }
  
  .form-status.info {
    background: rgba(255, 184, 0, 0.1);
    border: 1px solid rgba(255, 184, 0, 0.2);
    color: var(--color-gold);
  }
  
  .form-status.success {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
    color: #10b981;
  }
  
  .form-status.error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.2);
    color: #ef4444;
  }
</style>
